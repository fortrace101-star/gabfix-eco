# Gabfix client runtime configuration (copy to .env.local).
#
# Without this value the app runs its bundled mock auth/catalogue and never calls
# the backend. With it set, every request goes through the Hono `api` function.
#
# Web on this PC (or `npx expo start` in a browser):
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:54321/functions/v1/api
#
# Phone or Android emulator, including Expo web opened on the phone: in a dev
# build the app rewrites localhost/127.0.0.1 to the Expo dev-server host (or the
# browser's hostname) automatically, so the value above also works there.
# If you need to pin it instead, use the PC's LAN address:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:54321/functions/v1/api
#
# The local stack must be running:
#   cd backend && npx supabase start
#   cd backend && npx supabase functions serve api --no-verify-jwt
